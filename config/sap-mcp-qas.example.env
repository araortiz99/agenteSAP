# QAS runtime MCP integration — intentionally disabled by default.
AGENTESAP_SAP_RUNTIME_ENABLED=false

# Must remain QAS for this first runtime stage.
AGENTESAP_SAP_RUNTIME_LANDSCAPE=QAS

# Client-side declaration; the actual credential must be issued with this scope.
AGENTESAP_SAP_RUNTIME_SCOPE=mcp_readonly

# Optional system identifier used only for evidence provenance.
# AGENTESAP_SAP_RUNTIME_SYSTEM=S4QAS

# Explicit allowlist. Populate only after verifying the concrete read-only
# tool name in the installed sap-mcp-server tool catalog.
# AGENTESAP_SAP_RUNTIME_READ_TOOLS=<verified_read_tool>
# The query tool must also be included in the allowlist.
# AGENTESAP_SAP_RUNTIME_QUERY_TOOL=<verified_read_tool>
# AGENTESAP_SAP_RUNTIME_QUERY_ARGUMENT=query

# sap-mcp-server is a Linux binary. Use the executable available in the
# runtime environment (for example WSL/Linux).
AGENTESAP_SAP_MCP_COMMAND=sap-mcp-server
AGENTESAP_SAP_MCP_ARGS=

# Safe discovery mode: connects only to the MCP protocol and lists tools.
# It does not execute an SAP tool and does not authorize any runtime tool.
# Leave false until a QAS mcp_readonly connection is available.
AGENTESAP_SAP_RUNTIME_DISCOVERY=false

# Live smoke test is separate from normal CI and remains disabled by default.
# AGENTESAP_QAS_LIVE_TESTS=true
# AGENTESAP_QAS_LIVE_QUERY=MARA
