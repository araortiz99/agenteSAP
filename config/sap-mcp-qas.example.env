# QAS runtime MCP integration — intentionally disabled by default.
AGENTESAP_SAP_RUNTIME_ENABLED=false
AGENTESAP_SAP_RUNTIME_LANDSCAPE=QAS
AGENTESAP_SAP_RUNTIME_SCOPE=mcp_readonly

# Evidence provenance only; do not use this as an authorization boundary.
# AGENTESAP_SAP_RUNTIME_SYSTEM=S4QAS

# The concrete tool must be obtained from the REAL server catalog.
# The current official sap-mcp-server catalog exposes sap_select_table as a
# read-capable ABAP table-read tool, but the live QAS smoke must still verify
# that the installed binary advertises the configured tool.
# AGENTESAP_SAP_RUNTIME_READ_TOOLS=sap_select_table
# AGENTESAP_SAP_RUNTIME_QUERY_TOOL=sap_select_table
# AGENTESAP_SAP_RUNTIME_QUERY_ARGUMENT=<verified_argument>

# The official sap-mcp-server binary reads a local connections.json.
# Never commit this file or its clientSecret. In GitHub Actions it is supplied
# through the qas environment secret AGENTESAP_SAP_MCP_CONNECTIONS_JSON.
AGENTESAP_SAP_MCP_COMMAND=sap-mcp-server
AGENTESAP_SAP_MCP_ARGS=

# Safe discovery mode: protocol/catalog discovery only; no SAP tool execution
# and no runtime authorization. The CI workflow performs catalog discovery
# before the allowlist-gated smoke test.
AGENTESAP_SAP_RUNTIME_DISCOVERY=false

# Live smoke test is separate from normal CI and remains disabled by default.
# AGENTESAP_QAS_LIVE_TESTS=true
# AGENTESAP_QAS_LIVE_QUERY=MARA
